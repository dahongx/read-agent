# ── 运行模式 ──────────────────────────────────────────────
DEV_MODE=false
DEV_MODE_RAG=false

# ── 目录配置 ──────────────────────────────────────────────
UPLOAD_DIR=backend/uploads
PPT_CACHE_DIR=backend/uploads/ppt_cache

# PPT 生成 skill 目录。当前实现只调用 ppt-master，paper-to-ppt / paper-glance-skill 已不再使用。
SKILL_DIR=.claude/skills/ppt-master

# Claude CLI 可执行文件路径；如果 claude 已在 PATH 中，可留空
CLAUDE_CLI_PATH=

# Windows 下可选：如果 Claude CLI 需要显式指定 Git Bash，则填写路径
GIT_BASH_PATH=

# ── 问答 LLM 配置（OpenAI 兼容；推荐 Claude Sonnet 4.6 或 GPT-5.5）──
LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://aigc.zhengmi.org/v1
LLM_MODEL=claude-sonnet-4-6

# 本地向量模型
EMBED_MODEL_NAME=BAAI/bge-m3
EMBED_MODEL_DIR=backend/models/bge-m3
EMBED_CACHE_DIR=backend/models/cache

# Reranker（首次会下载模型到 EMBED_CACHE_DIR）
# bge-reranker-base 小且 CPU 友好；bge-reranker-v2-m3 质量更高但 CPU 慢
RERANKER_MODEL_NAME=BAAI/bge-reranker-base
# CPU 下默认关闭 rerank，靠 dense+BM25+RRF 已经够；有 GPU 改 true
RERANKER_ENABLED=false

# 检索参数（hybrid: dense + BM25 → RRF → 可选 rerank → top_final）
RAG_TOP_K_DENSE=15
RAG_TOP_K_BM25=15
RAG_TOP_K_FINAL=6
